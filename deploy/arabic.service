[Unit]
Description=Arabic family learning
After=network.target

[Service]
Type=simple
User=arabic
Group=arabic
WorkingDirectory=/opt/arabic/current
EnvironmentFile=/etc/arabic/app.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/arabic/current/.venv/bin/gunicorn --config /opt/arabic/current/gunicorn.conf.py wsgi:application
Restart=on-failure
RestartSec=5
TimeoutStopSec=40
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/arabic

[Install]
WantedBy=multi-user.target
